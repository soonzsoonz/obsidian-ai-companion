{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "CommonJS",
        "target": "ES2018",
        "allowJs": true,
        "noImplicitAny": true,
        "strict": true,
        // Required: obsidian.d.ts ships a HistoryHandler bug (Menu/Modal/PopoverSuggest
        // omit onHistoryBack). Our own src/ typechecks clean with this off.
        "skipLibCheck": true,
        "moduleResolution": "node",
        "importHelpers": false,
        "isolatedModules": true,
        "strictNullChecks": true,
        "lib": [
            "DOM",
            "ES5",
            "ES6",
            "ES7",
            "ES2018"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}